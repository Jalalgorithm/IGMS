# Base URL of the IGMS API. Leave unset (or keep the mock flag on) to run against
# the in-repo mock service in src/features/waitlist/services/waitlistApi.ts
VITE_API_URL=https://api.igms.example/v1

# "true" routes the waitlist AND EasyAsk through their in-repo mock services and
# never hits the network. Set to "false" once a backend is available at
# VITE_API_URL. EasyAsk's mock templates the answers rather than calling a model,
# so the flow is testable without an AI key.
VITE_USE_MOCK_API=true

# Stripe Payment Link used by the Donate button in the header. This public URL
# is safe to expose; do not put Stripe secret keys in any VITE_* variable.
VITE_DONATE_URL=https://buy.stripe.com/REPLACE_WITH_STRIPE_LINK

# Public contact address shown on the waitlist consent text for withdrawal
# requests. Leave unset to omit it.
VITE_CONTACT_EMAIL=

# Termageddon policy keys (public — they appear in the embed script URL).
VITE_TERMAGEDDON_PRIVACY_ID=VlVocVdXSkRSWFp1U1dzMVYwRTlQUT09
VITE_TERMAGEDDON_TERMS_ID=ZUhwYU5IQjFjMnRvWXpZdmVFRTlQUT09
VITE_TERMAGEDDON_DISCLAIMER_ID=UkZsNVNXRjFTRVp1VEU5T1VGRTlQUT09
VITE_TERMAGEDDON_COOKIES_ID=VEhWd1dVRlNkbVV2VlV3emQyYzlQUT09

# Usercentrics CMP settings id, injected into index.html at build time.
# REQUIRED in every environment (including Vercel) or the consent banner breaks.
VITE_USERCENTRICS_SETTINGS_ID=Uim9dKjxnujfy-
